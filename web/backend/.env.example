# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=5

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_USE_EMULATOR=false

# Autocomplete Data Path
AUTOCOMPLETE_DATA_PATH=places_engine/places_autocomplete_data_cleaned.json

# Cache TTL (in seconds)
CACHE_DEFAULT_TTL=300
CACHE_COUNTRY_TTL=3600
CACHE_CITY_TTL=1800
CACHE_PLACE_TTL=600

# Hard Limits - Autocomplete
AUTOCOMPLETE_QUERY_MIN_LENGTH=1
AUTOCOMPLETE_QUERY_MAX_LENGTH=100
AUTOCOMPLETE_RESULTS_MAX=50
AUTOCOMPLETE_RESULTS_DEFAULT=10

# Hard Limits - Firebase
FIREBASE_READS_PER_REQUEST=10
FIREBASE_ENABLE_FALLBACK=true
