                  "author": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/36988361@N08\">Center for Jewish History, NYC</a>",
                  "license": "No restrictions",
                  "license_url": "https://www.flickr.com/commons/usage/",
