                "attribution": {
                  "title": "Nyonya Laksa",
                  "author": "<a href=\"//commons.wikimedia.org/w/index.php?title=User:Giddy98&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Giddy98 (page does not exist)\">Giddy98</a>",
