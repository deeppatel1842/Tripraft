              "thumbnail": {
                "url": "https://upload.wikimedia.org/wikipedia/commons/5/51/Armero_aftermath_Marso.jpg",
                "width": 800,
                "height": 500,
                "attribution": {
                  "title": "Armero aftermath Marso",
                  "author": "Jeffrey Marso, USGS geologist",
                  "license": "Public domain",
                  "license_url": null,
