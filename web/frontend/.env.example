# TripRaft Frontend - Environment Configuration
# Copy this file to .env.local and fill in your values
# NO SECRETS should be committed to version control

# =========================================================================
# API CONFIGURATION (REQUIRED)
# =========================================================================

# API Base URL - Backend endpoint
VITE_API_BASE_URL=http://localhost:5000

# API Request Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# =========================================================================
# FRONTEND CONFIGURATION (REQUIRED)
# =========================================================================

# Frontend URL (used for redirects, links)
VITE_FRONTEND_URL=http://localhost:5173

# =========================================================================
# FEATURE FLAGS (OPTIONAL)
# =========================================================================

# Enable real-time updates (WebSocket)
VITE_FEATURE_REAL_TIME=false

# Enable advanced poll options
VITE_FEATURE_ADVANCED_POLLS=true

# Enable place search functionality
VITE_FEATURE_PLACE_SEARCH=true

# Enable AI-powered itinerary generation
VITE_FEATURE_ITINERARY=false

# Enable document collaboration features
VITE_FEATURE_COLLABORATION=false

# =========================================================================
# FIREBASE CONFIGURATION (REQUIRED)
# =========================================================================

# Firebase project configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# =========================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# =========================================================================

# Log level: debug, info, warn, error
VITE_LOG_LEVEL=info

# =========================================================================
# MAP CONFIGURATION (OPTIONAL)
# =========================================================================

# OpenStreetMap tile provider URL
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Default map center (latitude,longitude) - Default is India center
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629

# Default zoom level
VITE_MAP_DEFAULT_ZOOM=4

# =========================================================================
# DEVELOPMENT SETTINGS (OPTIONAL)
# =========================================================================

# Enable debug mode for development
DEBUG=false

# =========================================================================
# PRODUCTION SETTINGS (IMPORTANT)
# =========================================================================

# For production builds, override these values:
# VITE_API_BASE_URL=https://api.your-domain.com
# VITE_FRONTEND_URL=https://your-domain.com
# VITE_LOG_LEVEL=warn
