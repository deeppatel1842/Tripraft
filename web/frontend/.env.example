# =============================================================
# TripRaft Frontend — Environment Configuration
# Copy this file to .env.local and fill in your values
# NO SECRETS should be committed to version control
# =============================================================

# --- API Configuration (Required) ---
VITE_API_BASE_URL=http://localhost:5000
VITE_API_TIMEOUT=30000

# --- Frontend URL ---
VITE_FRONTEND_URL=http://localhost:5173

# --- WebSocket Configuration ---
VITE_WEBSOCKET_URL=http://localhost:5000/socket.io
VITE_WEBSOCKET_ENABLED=true
VITE_WEBSOCKET_FALLBACK_POLL_INTERVAL=30000

# --- Feature Flags ---
VITE_FEATURE_REAL_TIME=true
VITE_FEATURE_GROUP_PLANNER=true
VITE_FEATURE_ADVANCED_POLLS=true
VITE_FEATURE_PLACE_SEARCH=true
VITE_FEATURE_ITINERARY=true
VITE_FEATURE_COLLABORATION=true
VITE_FEATURE_ACTIVITY_FEED=true
VITE_FEATURE_ROLE_PERMISSIONS=true
VITE_FEATURE_EXPENSE_INTEGRATION=true

# --- Group Planner Configuration ---
GP_ENABLE_AUTOCOMPLETE=true
GP_AUTOCOMPLETE_DEBOUNCE_MS=300
GP_AUTOCOMPLETE_MIN_CHARS=2
GP_MAX_AUTOCOMPLETE_RESULTS=10

# --- Map Configuration ---
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629
VITE_MAP_DEFAULT_ZOOM=4

# --- UI & Theme Configuration ---
VITE_THEME_MODE=light
VITE_ENABLE_ANIMATIONS=true
VITE_ANIMATION_DURATION_MS=300

# --- Logging & Debugging ---
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_NETWORK_DEBUG=false

# --- Brand Configuration ---
VITE_APP_NAME=TripRaft
VITE_APP_DESCRIPTION=AI-powered travel planning platform
VITE_APP_TAGLINE=Discover. Plan. Explore.

# --- Production Overrides ---
# VITE_API_BASE_URL=https://api.tripraft.com
# VITE_WEBSOCKET_URL=wss://api.tripraft.com/socket.io
# VITE_FRONTEND_URL=https://tripraft.com
# VITE_LOG_LEVEL=warn
# VITE_ENABLE_ANALYTICS=true
