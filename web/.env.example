# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_BASE_URL=ws://localhost:3000

# Environment Variables Template
# 
# This file serves as a template for environment variables in the Travel Planner application.
# Copy this file to .env and fill in your actual values.
# 
# IMPORTANT: Never commit .env files with real credentials to version control!
# 
# Variables included:
# - Firebase configuration for authentication and database
# - API keys for external services (Google Maps, Amadeus, etc.)
# - Application configuration (URLs, feature flags)

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# External APIs (for backend integration)
VITE_AMADEUS_API_URL=https://api.amadeus.com
VITE_BOOKING_API_URL=https://api.booking.com
VITE_TRIPADVISOR_API_URL=https://api.tripadvisor.com

# Environment
NODE_ENV=development
