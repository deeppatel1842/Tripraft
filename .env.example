# =============================================================================
# BRAND CONFIGURATION
# =============================================================================
APP_NAME=YourBrandName
APP_DESCRIPTION=AI-powered travel planning platform
APP_TAGLINE=Discover. Plan. Explore.

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default for local dev):
# DATABASE_URL=sqlite:///web/database/tripraft.db
#
# PostgreSQL (production):
# DATABASE_URL=postgresql://tripraft:password@localhost:5432/tripraft
#
# Pool settings (PostgreSQL only):
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
# SQL_ECHO=false

# =============================================================================
# GOOGLE API CONFIGURATION
# =============================================================================
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=your-cert-url

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

# =============================================================================
# GROUP PLANNER CONFIGURATION
# =============================================================================

# Feature Flags
GP_FEATURE_ENABLED=true
GP_ENABLE_REAL_TIME_UPDATES=true
GP_ENABLE_EMAIL=true
GP_ENABLE_ACTIVITY_FEED=true
GP_ENABLE_ROLE_PERMISSIONS=true
GP_ENABLE_EXPENSE_INTEGRATION=true

# Business Rules & Limits
GP_MAX_MEMBERS_PER_GROUP=50
GP_MAX_PLACES_PER_GROUP=1000
GP_MAX_POLLS_PER_GROUP=500
GP_MAX_CHECKLIST_ITEMS_PER_GROUP=200
GP_MAX_PENDING_INVITATIONS=10
GP_INVITATION_EXPIRY_DAYS=7

# Real-Time Configuration
GP_WEBSOCKET_ENABLED=true
GP_FALLBACK_POLL_INTERVAL_MS=30000
GP_WEBSOCKET_PING_INTERVAL=30
GP_WEBSOCKET_PING_TIMEOUT=5

# Cache Settings (seconds)
GP_CACHE_TTL_GROUPS=300
GP_CACHE_TTL_MEMBERS=600
GP_CACHE_TTL_PLACES=900
GP_CACHE_TTL_POLLS=600
GP_CACHE_TTL_CHECKLIST=300
GP_CACHE_TTL_ACTIVITIES=600
GP_CACHE_TTL_ITINERARY=600
GP_CACHE_TTL_INVITATIONS=300

# Performance & Timeouts
GP_REQUEST_TIMEOUT_SEC=30
GP_DB_QUERY_TIMEOUT_SEC=10
GP_API_RESPONSE_TIMEOUT_SEC=5
GP_WEBSOCKET_BROADCAST_TIMEOUT_MS=100

# Logging & Debugging
GP_LOG_LEVEL=INFO
GP_DEBUG_LOGGING=false
GP_ENABLE_PERF_LOGGING=false
GP_LOG_SQL_QUERIES=false

# Email Configuration
GP_EMAIL_ENABLED=true
GP_EMAIL_TIMEOUT_SEC=5.0
GP_EMAIL_RETRY_ATTEMPTS=3
GP_EMAIL_BATCH_SIZE=50

# Database Configuration (Travel Data)
TRAVEL_DATA_DB_PATH=web/backend/data/travel_data_complete.db
TRAVEL_DATA_CACHE_SIZE_MB=100

# Role-Based Access Control
GP_ROLE_CREATOR=creator
GP_ROLE_ADMIN=admin
GP_ROLE_MEMBER=member
GP_ROLE_VIEWER=viewer

# Pagination
GP_PLACES_PAGE_SIZE=50
GP_ACTIVITIES_PAGE_SIZE=50
GP_MEMBERS_PAGE_SIZE=100

# Auto-Close Polls
GP_ENABLE_AUTO_CLOSE_POLLS=true
GP_POLL_CLOSE_JOB_INTERVAL_SEC=60

# =============================================================================
# EXPENSE ENGINE CONFIGURATION
# =============================================================================

# Cache TTL Settings (seconds)
EXPENSE_CACHE_TTL_USER=3600
EXPENSE_CACHE_TTL_GROUP=1800
EXPENSE_CACHE_TTL_EXPENSE=900
EXPENSE_CACHE_TTL_BALANCE=300
EXPENSE_CACHE_TTL_INVITATION=600
EXPENSE_CACHE_TTL_SETTLEMENT=900
EXPENSE_CACHE_TTL_ANALYTICS=1800
EXPENSE_CACHE_TTL_IDEMPOTENCY=86400

# Cache Freshness
EXPENSE_BALANCE_CACHE_MAX_AGE=300
EXPENSE_USER_CACHE_MAX_AGE=3600

# Balance Calculation
EXPENSE_BALANCE_TIMEOUT=10.0
EXPENSE_MIN_SETTLEMENT=0.01

# Business Rules
EXPENSE_MAX_GROUP_MEMBERS=100
EXPENSE_MAX_EXPENSES_PER_GROUP=10000
EXPENSE_INVITATION_EXPIRY_DAYS=7

# Email Service
EXPENSE_EMAIL_ENABLED=True
EXPENSE_EMAIL_TIMEOUT=5.0

# Rate Limiting
EXPENSE_MAX_OPERATIONS_PER_MINUTE=100

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=sqlite:///./database/expense_engine.db

# =============================================================================
# API RATE LIMITING & BUDGET
# =============================================================================
# Base API budget (calls per city search)
BASE_API_BUDGET=7
MAX_API_BUDGET=10
MIN_API_BUDGET=3

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=2000

# Requests per second for Google Places API
PLACES_API_RATE_LIMIT=10
# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=5
# Request timeout in seconds
API_REQUEST_TIMEOUT=30

# =============================================================================
# DYNAMIC RADIUS (HEURISTIC-BASED, NO CITY KEYWORDS)
# =============================================================================
# City type radii (km) - determined by population density
MEGA_CITY_RADIUS_KM=50.0
LARGE_CITY_RADIUS_KM=80.0
MEDIUM_CITY_RADIUS_KM=100.0
SMALL_CITY_RADIUS_KM=120.0
RURAL_RADIUS_KM=150.0

# Population density thresholds (people per sq km)
MEGA_CITY_DENSITY_THRESHOLD=5000
LARGE_CITY_DENSITY_THRESHOLD=1000
MEDIUM_CITY_DENSITY_THRESHOLD=500

# Adaptive radius adjustment
TARGET_MIN_RESULTS=20
TARGET_MAX_RESULTS=100
RADIUS_EXPAND_MULTIPLIER=1.3
RADIUS_SHRINK_MULTIPLIER=0.75

# =============================================================================
# ADAPTIVE BUDGET (CACHE-BASED)
# =============================================================================
# Cache performance thresholds
EXCELLENT_CACHE_RATIO=0.80
GOOD_CACHE_RATIO=0.60
POOR_CACHE_RATIO=0.30

# Budget scaling factors
EXCELLENT_BUDGET_MULTIPLIER=1.5
GOOD_BUDGET_MULTIPLIER=1.2
POOR_BUDGET_MULTIPLIER=0.8

# Budget adjustment interval (seconds)
BUDGET_ADJUSTMENT_INTERVAL=300

# =============================================================================
# SUBSCRIPTION TIER SYSTEM
# =============================================================================
# Default tier if not specified ('free' or 'paid')
DEFAULT_TIER=free

# --- FREE TIER LIMITS ---
# Free users get limited search: single API call, 50km radius, 20 results shown
# But can create trip plans using ALL places within 120km (same as paid)
# However, only 3 trip plans allowed (then paywall)
FREE_TIER_RADIUS_KM=50.0
FREE_TIER_API_BUDGET=1
FREE_TIER_RESULT_LIMIT=20
FREE_TIER_ENABLE_PHOTOS=true
FREE_TIER_ENABLE_ROUTING=false

# FREE TIER TRIP PLANNER LIMIT
# Free users can create only 3 trip plans, then must upgrade to PAID
FREE_TIER_TRIP_LIMIT=3

# --- PAID TIER LIMITS ---
# Paid users get full search: up to 7 API calls, 120km radius, unlimited results
# Unlimited trip plan creation
PAID_TIER_RADIUS_KM=120.0
PAID_TIER_API_BUDGET=7
PAID_TIER_RESULT_LIMIT=0
PAID_TIER_ENABLE_PHOTOS=true
PAID_TIER_ENABLE_ROUTING=true

# =============================================================================
# TRIP PLANNER CONFIGURATION (TIER-BASED)
# =============================================================================
# In-city trip radius (available to both free and paid tiers)
CITY_TRIP_RADIUS_KM=50.0

# Extended trip with day trips (PAID tier only)
DAY_TRIP_MIN_KM=40.0
DAY_TRIP_MAX_KM=120.0

# Trip pacing configurations (hours and activities per day)
# Relaxed: 10am-5pm, 3 activities, 6 hours
# Moderate: 9am-5pm, 4 activities, 7 hours
# Packed: 8am-8pm, 5 activities, 10 hours

# =============================================================================
# REQUEST COALESCING
# =============================================================================
# Timeout for coalescing duplicate requests (seconds)
COALESCE_TIMEOUT_SECONDS=10.0
# Maximum concurrent coalesced requests
MAX_COALESCED_REQUESTS=50

# =============================================================================
# CACHING STRATEGY
# =============================================================================
# Cache TTL in seconds (default: 7 days)
CACHE_TTL=604800
# Enable aggressive caching for production
ENABLE_AGGRESSIVE_CACHING=True
# Cache warming on startup
CACHE_WARMING_ENABLED=False

# =============================================================================
# PERFORMANCE & SCALABILITY
# =============================================================================
# Number of worker processes (for production with gunicorn)
WORKERS=4
# Worker timeout in seconds
WORKER_TIMEOUT=120
# Maximum requests per worker before restart
MAX_REQUESTS_PER_WORKER=1000
# Enable threading
WORKER_THREADS=2

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY
# =============================================================================
# Session configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
# Token expiry in seconds (default: 1 hour)
TOKEN_EXPIRY=3600

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ANALYTICS=False
ENABLE_DEBUG_MODE=False
ENABLE_API_MONITORING=True
# =============================================================================
# FLIGHT TRACKING AGENT CONFIGURATION
# =============================================================================

# External API Keys
# Kiwi (Tequila) API - for current flight prices
# Get your API key from: https://tequila.kiwi.com/
KIWI_API_KEY=your_kiwi_api_key_here

# Travelpayouts API - for historical price trends
# Get your token from: https://www.travelpayouts.com/
TRAVELPAYOUTS_API_TOKEN=your_travelpayouts_token_here

# Server Configuration
FLIGHT_TRACKER_DEBUG=false
FLIGHT_TRACKER_HOST=0.0.0.0
FLIGHT_TRACKER_PORT=5001

# Scheduler Configuration
FLIGHT_SCHEDULER_AUTO_START=true
FLIGHT_PRICE_CHECK_INTERVAL=60
FLIGHT_TREND_UPDATE_INTERVAL=6

# Cache TTL (seconds)
FLIGHT_CACHE_TTL_PRICES=1800
FLIGHT_CACHE_TTL_TRENDS=3600

# Alert Thresholds (percentage)
FLIGHT_PRICE_DROP_THRESHOLD=5.0
FLIGHT_PRICE_SPIKE_THRESHOLD=10.0

# Local LLM Configuration (Optional)
FLIGHT_LLM_ENABLED=false
FLIGHT_LLM_API_URL=http://localhost:11434
FLIGHT_LLM_MODEL=llama3